# --- Možnost A: Google (priporočeno) – en ključ za govor in prepoznavo ---
# console.cloud.google.com -> omogoči "Cloud Text-to-Speech API" in "Cloud Speech-to-Text API" -> API key
GOOGLE_API_KEY=
# Neobvezno: sl-SI-Chirp3-HD-Kore (ženski), sl-SI-Chirp3-HD-Charon (moški), ...
GOOGLE_TTS_VOICE=sl-SI-Chirp3-HD-Kore

# --- Možnost B: Azure Speech ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_TTS_VOICE=sl-SI-PetraNeural
