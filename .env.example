# --- Pametni pogovor (Gemini, brezplačno brez kartice) ---
# aistudio.google.com -> Get API key -> Create API key
GEMINI_API_KEY=
# Neobvezno: model (privzeto gemini-2.5-flash)
GEMINI_MODEL=

# Nastavite ENEGA ponudnika (če jih je več, velja prvi po vrsti: ElevenLabs, Google, Azure)

# --- ElevenLabs (brezplačni paket brez kartice: 10.000 znakov/mesec) ---
# elevenlabs.io -> Developers -> API Keys -> Create API key
ELEVENLABS_API_KEY=
# Neobvezno: ID glasu iz knjižnice glasov (privzeto "Sarah")
ELEVENLABS_VOICE_ID=

# --- Google (Chirp 3 HD) ---
GOOGLE_API_KEY=
GOOGLE_TTS_VOICE=sl-SI-Chirp3-HD-Kore

# --- Azure Speech ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_TTS_VOICE=sl-SI-PetraNeural
